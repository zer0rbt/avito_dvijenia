# Avito API (Настройки → Для профессионалов → API)
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_USER_ID=

# Профиль запуска: local | vps
APP_PROFILE=local

# База данных
DATABASE_URL=sqlite:///./data/avito_dvijenia.db

# Хранилище медиа: local | s3
MEDIA_STORE_BACKEND=local
MEDIA_STORE_LOCAL_PATH=./media_store
MEDIA_STORE_PUBLIC_BASE_URL=

# S3 / R2 (нужно только если MEDIA_STORE_BACKEND=s3)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# Публичный базовый URL для фида/медиа (Cloudflare Tunnel или домен на VPS)
PUBLIC_BASE_URL=

# Telegram-бот управления
TG_BOT_TOKEN=
TG_OPERATOR_CHAT_ID=

# Telegram-аккаунт для чтения канала поставщика (Telethon, B-018).
# my.telegram.org → API development tools. Без них media sync работает
# только через публичное веб-превью канала — последние ~20 постов.
TG_API_ID=
TG_API_HASH=

# Google Sheets — таблица-пульт и источники
GOOGLE_SERVICE_ACCOUNT_JSON=
ADMIN_SHEET_ID=

# Режим оператора
DRY_RUN_DEFAULT=true
MIN_BALANCE_RUB=300
MAX_ACTIVE_LISTINGS=100

# Остаток аванса за просмотры, ₽. API его не отдаёт (B-003), поле ведёт
# оператор по данным ЛК. Пока пусто — публикация заблокирована.
ADVANCE_RUB=
